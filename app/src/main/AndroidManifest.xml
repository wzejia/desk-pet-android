<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- S7-f 按住说话震动反馈（#2 修复） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- S5 KWS 常开前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- S27 包可见性（targetSdk 30+）：用 LAUNCHER intent 通配声明——可见所有有桌面
         入口的包，getLaunchIntentForPackage 才能拿到密集架入口；目标包实证改名后
         只改 AppLauncher.TARGET_PACKAGE，manifest 不再动。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

        <!-- 密集架基础设置「打开小朵」直拉悬浮窗（2026-10-09）：对外开透明入口 Activity + 悬浮窗服务，
        均 signature 权限把守——同签名包自动授权，其余调用方 SecurityException（密集架侧回退开 APP）。
        审计 D2-3 口径更新：exported 面 = MainActivity(LAUNCHER) + DebugBubbleReceiver(debug 守卫)
        + OverlayLaunchActivity(签名守卫，透明 trampoline) + PetOverlayService(签名守卫)。 -->
    <permission
        android:name="com.xiaoduo.deskpet.permission.START_OVERLAY_SERVICE"
        android:protectionLevel="signature" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="小朵"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <activity
            android:name=".OverlayLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="com.xiaoduo.deskpet.permission.START_OVERLAY_SERVICE"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|fontWeightAdjustment|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PetOverlayService"
            android:exported="true"
            android:permission="com.xiaoduo.deskpet.permission.START_OVERLAY_SERVICE" />

        <!-- S5 KWS 常开唤醒：microphone 前台服务；唯一拉起路径 = 设置页用户显式开关（禁止自启） -->
        <service
            android:name=".VoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- S3 验收期调试入口：adb 触发气泡（S2/S4 正式接线后随验收需要保留或移除）。
             exported=true 因 ColorOS 上 shell 广播无法触达非导出 receiver；仅响应包内自定义 action。 -->
        <receiver
            android:name=".ui.overlay.DebugBubbleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xiaoduo.deskpet.DEBUG_BUBBLE" />
                <action android:name="com.xiaoduo.deskpet.DEBUG_BUBBLE_APPEND" />
                <action android:name="com.xiaoduo.deskpet.DEBUG_BUBBLE_HIDE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.xiaoduo.deskpet.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
